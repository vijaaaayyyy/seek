{
  "name": "SEEK",
  "short_name": "SEEK",
  "description": "Search and read the King James Bible — love, mercy, sacrifice, and agape.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay", "browser"],
  "orientation": "any",
  "background_color": "#f7f5f0",
